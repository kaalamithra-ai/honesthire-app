{
  "name": "honest-hire-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Local Honest Hire API with Express and MongoDB",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:seed": "node seed.js",
    "db:clean": "node cleanup.js",
    "setup": "npm run db:seed",
    "test": "node --test --test-concurrency=1 test/api.test.js test/frontend.test.js"
  },
  "engines": { "node": ">=20.19" },
  "dependencies": {
    "cors": "2.8.5",
    "express": "4.21.2",
    "mongoose": "^8.19.1"
  }
}

