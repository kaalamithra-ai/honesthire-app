MONGODB_URI="mongodb://127.0.0.1:27017/honest_hire"
PORT=5000
CORS_ORIGINS="http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:8001,http://localhost:8001,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:5500,http://localhost:5500"

# API base URL used by the frontend.
# The server reads this once in backend/src/config.js and serves it to the page via GET /config.js,
# so the browser never hardcodes a host. Leave it unset for local development: the page then uses its
# own origin when served over http(s) and http://localhost:5000 otherwise. Set it only when the API
# lives on a different host than the UI.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000
# REACT_APP_API_URL is accepted as an alias for bundler-based frontends.
# REACT_APP_API_URL=http://127.0.0.1:5000

# Admin gate passcode. CHANGE THIS before any deployment and never commit a real value.
ADMIN_SECRET_KEY="change-me-before-deploying"
